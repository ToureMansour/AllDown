# Base URL of the AllDown API (no trailing slash).
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Public site URL used by canonical URLs, sitemap and robots.
# Vercel provides a production URL automatically; set this explicitly for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-web-domain.example

# Google Search Console verification token (the value in the HTML tag meta).
# GOOGLE_SITE_VERIFICATION=your-google-verification-token

# Optional public contact address shown in the footer. Leave empty to hide it.
# NEXT_PUBLIC_CONTACT_EMAIL=contact@your-domain.example

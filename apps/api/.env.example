# ---------------------------------------------------------------------------
# AllDown API configuration
# Copy this file to apps/api/.env and adjust the values.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of exact frontend origins allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of Express. Use 1 on Render/Vercel-style
# proxies, 0 for direct local/VM access.
TRUST_PROXY=0
LOG_LEVEL=info

# Public download limits
# Maximum size of one generated file, in MiB. Merged video+audio is counted.
MAX_DOWNLOAD_SIZE_MB=200
# yt-dlp process timeout for a download, in seconds.
DOWNLOAD_TIMEOUT_SECONDS=300
# yt-dlp process timeout for metadata analysis, in seconds.
ANALYZE_TIMEOUT_SECONDS=45
# Maximum number of simultaneous yt-dlp download processes.
MAX_CONCURRENT_DOWNLOADS=2

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Temporary files are always deleted after the response. Use local disk, not
# a network share. The directory must be writable by the API process.
TEMP_DIR=

# yt-dlp / FFmpeg
# Pinned release used by `npm run setup:engine`.
YTDLP_VERSION=2026.10.26
# Leave empty to auto-detect apps/api/bin/yt-dlp(.exe), node_modules/.bin or PATH.
YTDLP_PATH=
# Leave empty to auto-detect FFmpeg from ffmpeg-static, apps/api/bin or PATH.
FFMPEG_PATH=

# Optional domain allowlist. When set (comma-separated), only these domains and
# their subdomains are accepted. Example:
# ALLOWED_DOWNLOAD_HOSTS=youtube.com,youtu.be,tiktok.com,instagram.com,facebook.com,linkedin.com
# Leave empty to allow any public HTTP(S) host while still blocking private,
# loopback, link-local and cloud metadata addresses.
ALLOWED_DOWNLOAD_HOSTS=

# Required in production (minimum 32 characters). Signs short-lived download
# URLs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DOWNLOAD_SIGNING_SECRET=

# Optional public contact shown by the frontend is configured in apps/web,
# not here.
